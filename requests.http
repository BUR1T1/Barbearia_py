### Testes HTTP - API Barbearia
### Use com a extensao "REST Client" (VS Code) ou importe no Insomnia/Postman.
### O Membro 5 deve estender este arquivo com Barbeiro, Servico e Agendamento.

@base = http://localhost:5000

### Metadados da API
GET {{base}}/

### Documentacao Swagger UI
GET {{base}}/docs

### Especificacao OpenAPI JSON
GET {{base}}/openapi.json

# =====================================================================
#  CLIENTE (feito - Otavio)
# =====================================================================

### [201] Criar cliente
POST {{base}}/clientes
Content-Type: application/json

{
  "nome": "Joao da Silva",
  "telefone": "11999998888",
  "email": "joao@example.com"
}

### [200] Listar clientes (paginacao)
GET {{base}}/clientes?page=1&per_page=10

### [200] Listar clientes filtrando por nome
GET {{base}}/clientes?nome=joao

### [200] Detalhar cliente
GET {{base}}/clientes/1

### [404] Cliente inexistente
GET {{base}}/clientes/9999

### [200] Atualizacao completa (PUT)
PUT {{base}}/clientes/1
Content-Type: application/json

{
  "nome": "Joao da Silva Junior",
  "telefone": "11988887777",
  "email": "joao.junior@example.com"
}

### [200] Atualizacao parcial (PATCH)
PATCH {{base}}/clientes/1
Content-Type: application/json

{
  "telefone": "11900000000"
}

### [422] Payload invalido (nome curto e sem telefone)
POST {{base}}/clientes
Content-Type: application/json

{
  "nome": "A"
}

### [400] Corpo ausente / nao-JSON
POST {{base}}/clientes
Content-Type: application/json

### [204] Remover cliente
DELETE {{base}}/clientes/1

# =====================================================================
#  BARBEIRO (CRUD completo)
# =====================================================================

### [201] Criar barbeiro
POST {{base}}/barbeiros
Content-Type: application/json

{
  "nome": "Carlos Machado",
  "especialidade": "Degradê e Barboterapia",
  "telefone": "11977776666",
  "ativo": true
}

### [200] Listar barbeiros (paginacao)
GET {{base}}/barbeiros?page=1&per_page=10

### [200] Listar barbeiros filtrando por nome
GET {{base}}/barbeiros?nome=carlos

### [200] Listar barbeiros filtrando por status ativo
GET {{base}}/barbeiros?ativo=true

### [200] Detalhar barbeiro
GET {{base}}/barbeiros/1

### [404] Barbeiro inexistente
GET {{base}}/barbeiros/9999

### [200] Atualizacao completa de barbeiro (PUT)
PUT {{base}}/barbeiros/1
Content-Type: application/json

{
  "nome": "Carlos Machado Silva",
  "especialidade": "Corte Clássico e Barba",
  "telefone": "11988889999",
  "ativo": true
}

### [200] Atualizacao parcial de barbeiro (PATCH)
PATCH {{base}}/barbeiros/1
Content-Type: application/json

{
  "especialidade": "Visagismo e Barba"
}

### [422] Barbeiro payload invalido (nome em branco)
POST {{base}}/barbeiros
Content-Type: application/json

{
  "nome": "A"
}

### [400] Barbeiro filtro ativo com valor invalido
GET {{base}}/barbeiros?ativo=invalido

### [204] Remover barbeiro
DELETE {{base}}/barbeiros/1


# =====================================================================
#  SERVICO (CRUD completo)
# =====================================================================

### [201] Criar servico
POST {{base}}/servicos
Content-Type: application/json

{
  "nome": "Corte Masculino",
  "descricao": "Corte na tesoura e maquina com finalizacao",
  "preco": 45.00,
  "duracao_min": 30
}

### [200] Listar servicos (paginacao)
GET {{base}}/servicos?page=1&per_page=10

### [200] Listar servicos filtrando por nome
GET {{base}}/servicos?nome=corte

### [200] Listar servicos filtrando por faixa de preco
GET {{base}}/servicos?preco_min=30&preco_max=100

### [200] Detalhar servico
GET {{base}}/servicos/1

### [404] Servico inexistente
GET {{base}}/servicos/9999

### [200] Atualizacao completa de servico (PUT)
PUT {{base}}/servicos/1
Content-Type: application/json

{
  "nome": "Corte Masculino Premium",
  "descricao": "Corte com lavagem e finalizacao",
  "preco": 59.90,
  "duracao_min": 45
}

### [200] Atualizacao parcial de servico (PATCH)
PATCH {{base}}/servicos/1
Content-Type: application/json

{
  "preco": 65.00
}

### [422] Servico com preco invalido (menor ou igual a zero)
POST {{base}}/servicos
Content-Type: application/json

{
  "nome": "Barba",
  "preco": 0
}

### [400] Servico filtro de preco com valor invalido
GET {{base}}/servicos?preco_min=abc

### [204] Remover servico
DELETE {{base}}/servicos/1

# =====================================================================
#  AGENDAMENTO (CRUD + relacionamentos)
# =====================================================================

### [201] Criar agendamento
POST {{base}}/agendamentos
Content-Type: application/json

{
  "data_hora": "2026-09-03T14:30:00",
  "cliente_id": 1,
  "barbeiro_id": 1,
  "servico_ids": [1],
  "observacao": "Preferencia por tesoura"
}

### [200] Listar agendamentos com filtros
GET {{base}}/agendamentos?status=agendado&cliente_id=1&page=1&per_page=10

### [200] Detalhar com dados relacionados
GET {{base}}/agendamentos/1

### [200] Atualizar parcialmente
PATCH {{base}}/agendamentos/1
Content-Type: application/json

{"status": "concluido"}

### [404] Agendamento inexistente
GET {{base}}/agendamentos/9999

### [422] Referencia inexistente
POST {{base}}/agendamentos
Content-Type: application/json

{"data_hora": "2026-09-03T14:30:00", "cliente_id": 9999, "barbeiro_id": 1, "servico_ids": [1]}

### [204] Remover agendamento
DELETE {{base}}/agendamentos/1
